# Server Configuration
# PostgreSQL connection string for the database
DATABASE_URL=

# Minimum 32 characters long secret for signing JWTs
AUTH_SECRET=

# Redis configuration for Upstash (optional, fallback to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Provider Keys (optional, for Gemini and Groq fallback)
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=

# Application Mode
# Set to true to enable demo features
DEMO_MODE=false
# Set to true to allow database seeding
ALLOW_SEED=false

# Public Configuration
# Base URL of the application
NEXT_PUBLIC_SITE_URL=
